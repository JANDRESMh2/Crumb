# Copy this file to .env, restrict its permissions, and replace blank values.
CRUMB_DEBUG=true
CRUMB_EMAIL_MODE=console
CRUMB_RECOVERY_HMAC_KEY=''
CRUMB_ALLOWED_HOSTS=''

# For CRUMB_EMAIL_MODE=smtp, use the Brevo SMTP login and SMTP key.
CRUMB_EMAIL_HOST_USER=''
CRUMB_EMAIL_HOST_PASSWORD=''
CRUMB_DEFAULT_FROM_EMAIL=''

# Required when CRUMB_DEBUG=false.
CRUMB_SECRET_KEY=''
